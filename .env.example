# Chat and dream models run on Workers AI through the env.AI binding — no key needed.

# Signs login sessions: any long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# Sender for sign-in codes, on a domain with Cloudflare Email Sending enabled
EMAIL_FROM=memory@example.com

# Optional admin key: "Authorization: Bearer <key>" reaches every user's HTTP API (/api)
MEMORY_API_KEY=
